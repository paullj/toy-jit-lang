{
  "name": "toy-lang",
  "displayName": "Toy Language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:toy"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "toy",
        "extensions": [
          ".toy"
        ],
        "aliases": [
          "toy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "toy",
        "scopeName": "source.toy",
        "path": "./syntaxes/toy.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
