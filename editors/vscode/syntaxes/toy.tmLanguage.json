{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "fileTypes": [
    ".toy"
  ],
  "name": "toy",
  "patterns": [
    {
      "match": "#[^\\r\\n]*",
      "name": "comment.line.number-sign.toy"
    },
    {
      "match": "\\(",
      "name": "punctuation.paren.open.toy"
    },
    {
      "match": "\\)",
      "name": "punctuation.paren.close.toy"
    },
    {
      "match": ",",
      "name": "punctuation.comma.toy"
    },
    {
      "match": ":",
      "name": "punctuation.colon.toy"
    },
    {
      "match": "\\+",
      "name": "keyword.operator.arithmetic.toy"
    },
    {
      "match": "-",
      "name": "keyword.operator.arithmetic.toy"
    },
    {
      "match": "\\*",
      "name": "keyword.operator.arithmetic.toy"
    },
    {
      "match": "/",
      "name": "keyword.operator.arithmetic.toy"
    },
    {
      "match": "%",
      "name": "keyword.operator.arithmetic.toy"
    },
    {
      "match": "\\+\\.",
      "name": "keyword.operator.arithmetic.float.toy"
    },
    {
      "match": "-\\.",
      "name": "keyword.operator.arithmetic.float.toy"
    },
    {
      "match": "\\*\\.",
      "name": "keyword.operator.arithmetic.float.toy"
    },
    {
      "match": "/\\.",
      "name": "keyword.operator.arithmetic.float.toy"
    },
    {
      "match": "=",
      "name": "keyword.operator.assignment.toy"
    },
    {
      "match": "==",
      "name": "keyword.operator.comparison.toy"
    },
    {
      "match": "!=",
      "name": "keyword.operator.comparison.toy"
    },
    {
      "match": "!",
      "name": "keyword.operator.logical.toy"
    },
    {
      "match": ">",
      "name": "keyword.operator.comparison.toy"
    },
    {
      "match": "<",
      "name": "keyword.operator.comparison.toy"
    },
    {
      "match": ">=",
      "name": "keyword.operator.comparison.toy"
    },
    {
      "match": "<=",
      "name": "keyword.operator.comparison.toy"
    },
    {
      "match": ">\\.",
      "name": "keyword.operator.comparison.float.toy"
    },
    {
      "match": "<\\.",
      "name": "keyword.operator.comparison.float.toy"
    },
    {
      "match": ">=\\.",
      "name": "keyword.operator.comparison.float.toy"
    },
    {
      "match": "<=\\.",
      "name": "keyword.operator.comparison.float.toy"
    },
    {
      "match": "and",
      "name": "keyword.operator.logical.toy"
    },
    {
      "match": "or",
      "name": "keyword.operator.logical.toy"
    },
    {
      "match": "true",
      "name": "constant.language.boolean.toy"
    },
    {
      "match": "false",
      "name": "constant.language.boolean.toy"
    },
    {
      "match": "[a-zA-Z][a-zA-Z0-9_]*",
      "name": "variable.other.toy"
    },
    {
      "match": "0b[01]+(?:_[01]+)*",
      "name": "constant.numeric.integer.binary.toy"
    },
    {
      "match": "0o[0-7]+(?:_[0-7]+)*",
      "name": "constant.numeric.integer.octal.toy"
    },
    {
      "match": "0x[0-9a-fA-F]+(?:_[0-9a-fA-F]+)*",
      "name": "constant.numeric.integer.hexadecimal.toy"
    },
    {
      "match": "[0-9]+(?:_[0-9]+)*",
      "name": "constant.numeric.integer.decimal.toy"
    },
    {
      "match": "[0-9]+(?:_[0-9]+)*\\.[0-9]+(?:_[0-9]+)*(?:[eE][+-]?[0-9]+)?",
      "name": "constant.numeric.float.toy"
    },
    {
      "match": "[0-9]+(?:_[0-9]+)*[eE][+-]?[0-9]+",
      "name": "constant.numeric.float.toy"
    },
    {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.toy"
    },
    {
      "match": "\"\"\"[^\"]*\"\"\"",
      "name": "string.quoted.triple.toy"
    }
  ],
  "scopeName": "source.toy"
}
